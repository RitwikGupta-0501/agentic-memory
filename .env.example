# FalkorDB Database Configuration
# Option A: Local Docker Instance (Default)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_USERNAME=
FALKORDB_SSL=false

# Option B: FalkorDB Cloud (https://cloud.falkordb.com)
# Option B1: Full Connection URL
# FALKORDB_URL=falkors://default:your-cloud-password@cluster-id.cloud.falkordb.com:6379
# Option B2: Discrete Cloud Parameters
# FALKORDB_HOST=cluster-id.cloud.falkordb.com
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your-cloud-password
# FALKORDB_SSL=true
# FALKORDB_SSL_CERT_REQS=required

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Multi-Tenancy Defaults
DEFAULT_TENANT_ID=acme-payments
DEFAULT_USER_ID=alice_sre

# LLM Configuration (Set LLM_PROVIDER to openai, gemini, anthropic, or mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
